{
  "name": "@decision-models-evals/eval-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "migrations:local": "wrangler d1 migrations apply DB --local",
    "migrations:remote": "wrangler d1 migrations apply DB --remote",
    "mock:jev": "tsx scripts/mock-jev.ts",
    "seed:generate": "tsx scripts/seed-nba.ts",
    "seed:apply:local": "wrangler d1 execute DB --local --file scripts/seed.generated.sql",
    "seed:apply:remote": "wrangler d1 execute DB --remote --file scripts/seed.generated.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250913.0",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  }
}
