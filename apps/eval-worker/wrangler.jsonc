{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eval-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "triggers": {
    "crons": ["0 14 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eval-db",
      "database_id": "b6a1e0d2-4c3f-4a8e-9f2d-7c5b1a3e8d4"
    }
  ]
}
